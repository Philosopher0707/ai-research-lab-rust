# AI Research Lab — Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file:   cp .env.example .env
# Load in shell:    set -a && source .env && set +a
# Or use direnv:    echo 'dotenv' >> .envrc && direnv allow
# ─────────────────────────────────────────────────────────────────────────────


# ══════════════════════════════════════════════════════════════════════════════
# ACTIVE PROVIDER
# One of: anthropic | openai | openrouter | deepseek | zhipu | minimax | xai | local
# Leave unset to auto-detect from whichever API key is present below.
# ══════════════════════════════════════════════════════════════════════════════
# LAB_PROVIDER=anthropic


# ══════════════════════════════════════════════════════════════════════════════
# MODEL OVERRIDE  (overrides the provider default)
# ══════════════════════════════════════════════════════════════════════════════
# LAB_MODEL=claude-sonnet-4-6          # Anthropic
# LAB_MODEL=gpt-4o                      # OpenAI
# LAB_MODEL=deepseek-chat               # DeepSeek
# LAB_MODEL=glm-4-flash                 # ZhipuAI
# LAB_MODEL=MiniMax-Text-01             # MiniMax
# LAB_MODEL=grok-2                      # xAI
# LAB_MODEL=anthropic/claude-opus-4     # via OpenRouter
# LAB_MODEL=qwen/qwen3-235b-a22b:free   # free model via OpenRouter


# ══════════════════════════════════════════════════════════════════════════════
# 1.  ANTHROPIC  —  claude-sonnet-4-6, claude-opus-4, claude-haiku-4-5
#     API key:  https://console.anthropic.com/settings/keys
#
#     NOTE: claude.ai Pro/Team subscription is for the web app only.
#           API access requires a separate key from console.anthropic.com.
#           The two are billed independently.
# ══════════════════════════════════════════════════════════════════════════════
ANTHROPIC_API_KEY=sk-ant-api03-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX


# ══════════════════════════════════════════════════════════════════════════════
# 2.  OPENAI  —  gpt-4o, gpt-4o-mini, o3-mini, o1-preview
#     API key:  https://platform.openai.com/api-keys
# ══════════════════════════════════════════════════════════════════════════════
OPENAI_API_KEY=sk-proj-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# OPENAI_ORG_ID=org-XXXXXXXXXXXXXXXX   # optional — for org-level billing


# ══════════════════════════════════════════════════════════════════════════════
# 3.  OPENROUTER  —  single key, 300+ models
#     API key:  https://openrouter.ai/settings/keys
#     Models:   https://openrouter.ai/models
#
#     Popular model IDs:
#       anthropic/claude-opus-4
#       anthropic/claude-sonnet-4-5
#       meta-llama/llama-3.3-70b-instruct:free
#       qwen/qwen3-235b-a22b:free
#       google/gemini-2.0-flash-exp:free
#       mistralai/mistral-large
# ══════════════════════════════════════════════════════════════════════════════
OPENROUTER_API_KEY=sk-or-v1-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX


# ══════════════════════════════════════════════════════════════════════════════
# 4.  DEEPSEEK  —  deepseek-chat, deepseek-reasoner, deepseek-coder
#     API key:  https://platform.deepseek.com/api_keys
#     Pricing:  ~$0.14/M tokens (very cheap)
# ══════════════════════════════════════════════════════════════════════════════
DEEPSEEK_API_KEY=sk-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX


# ══════════════════════════════════════════════════════════════════════════════
# 5.  ZHIPU AI (智谱AI)  —  glm-4, glm-4-flash, glm-4-plus, glm-4-long
#     API key:  https://open.bigmodel.cn/usercenter/apikeys
#     glm-4-flash is free-tier with generous limits
# ══════════════════════════════════════════════════════════════════════════════
ZHIPU_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX.XXXXXXXXXXXXXXXX


# ══════════════════════════════════════════════════════════════════════════════
# 6.  MINIMAX  —  MiniMax-Text-01, abab6.5s-chat, abab6.5-chat
#     API key:  https://platform.minimax.chat/
#     Group ID: required — find in your platform dashboard
# ══════════════════════════════════════════════════════════════════════════════
MINIMAX_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
MINIMAX_GROUP_ID=XXXXXXXXXXXXXXXXXX


# ══════════════════════════════════════════════════════════════════════════════
# 7.  xAI (Grok)  —  grok-2, grok-beta, grok-2-mini
#     API key:  https://console.x.ai/
# ══════════════════════════════════════════════════════════════════════════════
XAI_API_KEY=xai-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX


# ══════════════════════════════════════════════════════════════════════════════
# 8.  LOCAL  —  Ollama, LM Studio, vLLM, any OpenAI-compatible server
#     No key needed for local servers.
# ══════════════════════════════════════════════════════════════════════════════
# LAB_PROVIDER=local
# LAB_BASE_URL=http://localhost:11434/v1   # Ollama default
# LAB_MODEL=llama3.2
# LAB_API_KEY=...                           # optional only if your local proxy requires it


# ══════════════════════════════════════════════════════════════════════════════
# LAB RUNTIME SETTINGS  (all optional)
# ══════════════════════════════════════════════════════════════════════════════
# LAB_WORKSPACE=/path/to/project      # default: current directory
# LAB_MAX_AGENTS=20                   # max concurrent agents
# LAB_DEBUG=1                         # verbose debug logs
# LAB_VERBOSE=1                       # log every event from EventBus
# LAB_BASE_URL=https://...            # override API endpoint (e.g. proxy)
# LAB_API_KEY=sk-...                  # override whichever key is detected
